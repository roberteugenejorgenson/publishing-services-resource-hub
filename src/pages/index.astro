---
import { ArrowRight, Globe, Layers, Sparkles } from '@lucide/astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import ResourceCard from '../components/ResourceCard.astro';
import HomeSearch from '../components/HomeSearch.astro';
import { departments } from '../data/departments';
import { getPublishedResources } from '../lib/resources';
const resources = await getPublishedResources();
const featured = resources.filter((resource) => resource.featured).slice(0, 3);
const recentlyUpdated = resources.slice(0, 3);
const icons = { 'global-operations': Globe, 'product-management': Layers };
---
<BaseLayout title="Publishing Services Resource Hub" description="Your centralized destination for tools, documentation, presentations, and resources supporting Publishing Services teams." active="home">
  <section class="hero"><div class="hero-orb orb-one"></div><div class="hero-orb orb-two"></div><div class="container hero-inner"><div class="hero-copy"><span class="hero-kicker"><Sparkles size={15} aria-hidden="true" /> A shared workspace for better work</span><h1>Publishing Services<br /><span>Resource Hub</span></h1><p>Your centralized destination for tools, documentation, presentations, and resources supporting Publishing Services teams.</p><div class="hero-actions"><a class="primary-button" href="/global-operations/">Explore Global Operations <ArrowRight size={17} aria-hidden="true" /></a><a class="secondary-button" href="/product-management/">Explore Product Management <ArrowRight size={17} aria-hidden="true" /></a></div><div class="hero-footnote"><span class="pulse-dot"></span> One place for the resources your team relies on</div></div><div class="hero-art"><img class="hero-seal" src="/images/publishing-services-seal.png" alt="Publishing Services Department seal" /></div></div></section>
  <section class="container departments-section"><div class="section-heading"><div><span class="eyebrow">Explore by team</span><h2>Find your department</h2></div><p>Curated resources to make the day-to-day easier and help great work move forward.</p></div><div class="department-grid">{departments.map((department) => { const Icon = icons[department.slug]; return <a class="department-card" href={`/${department.slug}/`}><div class="department-icon"><Icon size={23} stroke-width={1.8} aria-hidden="true" /></div><div class="dept-arrow"><ArrowRight size={18} aria-hidden="true" /></div><h3>{department.name}</h3><p>{department.shortDescription}</p><span class="department-link">Explore resources <ArrowRight size={15} aria-hidden="true" /></span></a>; })}</div></section>
  <section class="container search-section"><HomeSearch resources={resources} /></section>
  <section class="container resource-section"><div class="section-heading"><div><span class="eyebrow">Handpicked for you</span><h2>Featured resources</h2></div><a class="section-link" href="/global-operations/">Browse libraries <ArrowRight size={15} aria-hidden="true" /></a></div>{featured.length ? <div class="resource-grid">{featured.map((resource) => <ResourceCard resource={resource} />)}</div> : <div class="home-empty"><span>✧</span><div><strong>Featured resources are on their way</strong><p>When editors highlight a resource, it will show up here.</p></div></div>}</section>
  <section class="container resource-section recent-section"><div class="section-heading"><div><span class="eyebrow">Fresh from the teams</span><h2>Recently updated</h2></div></div>{recentlyUpdated.length ? <div class="resource-grid">{recentlyUpdated.map((resource) => <ResourceCard resource={resource} />)}</div> : <div class="home-empty"><span>◷</span><div><strong>No published resources yet</strong><p>Newly published resources will appear here, sorted by last updated date.</p></div></div>}</section>
</BaseLayout>
<style>
  .hero{position:relative;overflow:hidden;background:linear-gradient(112deg,#f0f4ff 0%,#f4f2ff 48%,#f9faff 100%);border-bottom:1px solid #e9ecf7}.hero::after{content:"";position:absolute;inset:0;background-image:radial-gradient(#8ca0e722 1px,transparent 1px);background-size:22px 22px;mask-image:linear-gradient(90deg,transparent,#000 45%,transparent);pointer-events:none}.hero-inner{position:relative;z-index:1;min-height:475px;display:grid;grid-template-columns:1.1fr .9fr;align-items:center;gap:30px;padding-block:54px}.hero-copy{max-width:620px}.hero-kicker{display:inline-flex;align-items:center;gap:8px;border:1px solid #dce3fb;background:#ffffffa8;border-radius:999px;padding:8px 12px;color:#5368bd;font-size:.75rem;font-weight:700}.hero h1{font-size:clamp(2.7rem,5vw,4.25rem);line-height:1.05;letter-spacing:-.065em;margin:22px 0 17px;color:#1b2843}.hero h1 span{background:linear-gradient(95deg,#087da4,#84aa00);color:transparent;background-clip:text}.hero-copy>p{max-width:560px;font-size:1.03rem;line-height:1.75;color:#64718b;margin:0}.hero-actions{display:flex;gap:11px;flex-wrap:wrap;margin-top:27px}.primary-button,.secondary-button{display:inline-flex;align-items:center;justify-content:center;gap:10px;min-height:47px;padding:0 17px;border-radius:11px;font-size:.81rem;font-weight:700;transition:transform .18s,box-shadow .18s}.primary-button{background:linear-gradient(110deg,#087da4,#0c91ae);color:white;box-shadow:0 8px 17px #087da433}.primary-button:hover,.secondary-button:hover{transform:translateY(-2px)}.secondary-button{border:1px solid #d8dfef;background:#ffffffb8;color:#45546f}.hero-footnote{display:flex;align-items:center;gap:8px;margin-top:24px;color:#8290a5;font-size:.75rem}.pulse-dot{width:7px;height:7px;border-radius:50%;background:#62b995;box-shadow:0 0 0 4px #62b99522}.hero-orb{position:absolute;border-radius:50%;filter:blur(1px)}.orb-one{width:350px;height:350px;background:#b9c8ff32;right:7%;top:-24%}.orb-two{width:240px;height:240px;background:#d8baff29;right:32%;bottom:-31%}.hero-art{height:340px;position:relative;display:grid;place-items:center}.hero-seal{width:min(100%,330px);aspect-ratio:1;object-fit:contain;border-radius:50%;background:#fff;border:8px solid #fff;box-shadow:0 18px 45px #087da42b,0 0 0 1px #087da426}.departments-section{padding-top:72px}.section-heading{display:flex;justify-content:space-between;align-items:end;gap:20px;margin-bottom:22px}.section-heading h2{font-size:1.8rem;letter-spacing:-.045em;margin:7px 0 0;color:#1f2c45}.section-heading>p{max-width:390px;color:#748198;font-size:.84rem;line-height:1.6;margin:0}.department-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18px}.department-card{position:relative;padding:25px;background:#fff;border:1px solid #e8ecf4;border-radius:19px;box-shadow:0 5px 18px #23365d09;transition:transform .2s,box-shadow .2s,border-color .2s}.department-card:hover{transform:translateY(-3px);box-shadow:0 14px 32px #23365d16;border-color:#dbe3fb}.department-icon{width:49px;height:49px;border-radius:15px;display:grid;place-items:center;background:linear-gradient(140deg,#eef2ff,#f5f0ff);color:#516bd6}.dept-arrow{position:absolute;right:24px;top:28px;color:#9aa6bd}.department-card h3{font-size:1.15rem;margin:20px 0 8px;letter-spacing:-.025em}.department-card p{max-width:510px;min-height:43px;margin:0;color:#718097;font-size:.84rem;line-height:1.6}.department-link,.section-link{display:inline-flex;align-items:center;gap:7px;margin-top:20px;color:#4f68d0;font-size:.8rem;font-weight:700}.search-section{padding-top:66px}.resource-section{padding-top:70px}.resource-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px}.section-link{margin:0}.home-empty{display:flex;align-items:center;gap:16px;padding:23px;background:#fff;border:1px dashed #dbe2ef;border-radius:16px}.home-empty>span{width:42px;height:42px;display:grid;place-items:center;border-radius:12px;background:#f1f3fc;color:#7280c7;font-size:1.4rem}.home-empty strong{font-size:.9rem}.home-empty p{margin:4px 0 0;color:#78859a;font-size:.8rem}.recent-section{padding-top:65px}@media(max-width:900px){.hero-inner{grid-template-columns:1fr .75fr}.hero-art{transform:scale(.82);transform-origin:center}.resource-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:700px){.hero-inner{min-height:auto;grid-template-columns:1fr;padding-block:54px 30px}.hero-art{height:250px;margin-top:0;transform:scale(.75)}.hero h1{font-size:2.8rem}.department-grid{grid-template-columns:1fr}.section-heading{align-items:flex-start;flex-direction:column}.section-heading h2{font-size:1.55rem}.resource-grid{grid-template-columns:1fr}.departments-section{padding-top:52px}.search-section{padding-top:48px}.resource-section{padding-top:52px}}
</style>
